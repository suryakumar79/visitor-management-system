# Copy to .env and adjust. Never commit .env.

# ---- Database ---------------------------------------------------------------
# Default: a SQLite file (nothing to install).
DB_PATH=./data/vms.db
# PostgreSQL instead (recommended for production). Uncomment to switch, see README "Switching to PostgreSQL":
# DATABASE_URL=postgres://vms:change-me@localhost:5432/vms
# DB_SSL=true                       # TLS to the database server
# DB_POOL_MAX=10

# ---- Public address ---------------------------------------------------------
# Used in links sent by e-mail. Behind a reverse proxy also set ORIGIN (the public https URL).
FRONTEND_BASE_URL=http://localhost:5173
# ORIGIN=https://visitors.example.com
# ALLOWED_ORIGINS=                  # extra origins allowed to call the API (comma separated), normally empty

# ---- Branding (optional) ----------------------------------------------------
PUBLIC_APP_NAME=Visitor Management System
PUBLIC_ORG_NAME=

# ---- Test mode --------------------------------------------------------------
# true  = the OTP is shown on the visitor login page and e-mails/messages are printed to the server console.
# NEVER enable on a public server. Leave empty/false for real use.
PUBLIC_SHOW_TEST_OTP=true

# ---- Security ---------------------------------------------------------------
SESSION_HOURS=12                    # staff sessions end after this many hours (1-168)
# APP_SECRET=                       # optional: key for encrypting settings; defaults to a random secret kept in the database

# ---- First start ------------------------------------------------------------
# Optional. If a password is empty or weak, a strong one is generated and printed once in the server log.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true                 # false = create only the admin account (no demo departments/staff/HR/reception)
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=
SEED_RECEPTIONIST_EMAIL=reception@example.com
SEED_RECEPTIONIST_PASSWORD=

# ---- Optional outgoing webhook (SMS / WhatsApp / chat) ----------------------
# The app POSTs JSON {type, ...} to this https URL, signed with HMAC-SHA256 in the X-VMS-Signature header.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=
